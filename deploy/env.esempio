# Le impostazioni di Repobay sul server: /etc/repobay/env (di root, permessi 600).
# Lo legge systemd all'avvio del servizio (deploy/repobay.service). Dopo ogni modifica: systemctl restart repobay
# Una riga per variabile, NOME=valore, senza spazi intorno all'«=» e senza virgolette. Le righe con # sono commenti.
# Tutte le variabili lette da server/config.js sono qui; quelle commentate valgono col loro predefinito.
# NIENTE chiavi vere in questo file d'esempio: solo segnaposto. Le chiavi vere stanno solo in /etc/repobay/env.

# ---------------------------------------------------------------- la piattaforma
# il nome (compare su pagine, email, badge)
APP_NOME=Repobay
# l'indirizzo pubblico, in https (i link di ritorno di Stripe e GitHub e quelli nelle email partono da qui)
APP_URL=https://tuodominio.it
# la porta su cui ascolta Node (Caddy gira le richieste qui: deve combaciare con il Caddyfile)
APP_PORTA=4600
# la cartella del database (officina.db), delle copie giornaliere (copie/) e della chiave segreto.key se manca APP_SEGRETO
APP_DATI=/var/lib/repobay
# chi vede il Pannello: email (confermate) o login GitHub, separati da virgola
APP_ADMIN=tu@example.com
# la chiave che cifra gettoni GitHub, dati fiscali, 2FA e webhook nel database. installa.sh ne genera una a caso.
# SE LA PERDI, I DATI CIFRATI NON SI LEGGONO PIÙ: copiala nel portachiavi del Mac o in un gestore di password.
APP_SEGRETO=metti-qui-una-stringa-casuale-lunga
# la lingua predefinita delle pagine: it o en
APP_LINGUA=it
# controlla le password nuove su Have I Been Pwned (escono solo 5 caratteri dell'hash): 1 = sì
APP_PWNED=1
# prima di poter incassare: niente pagamenti, i business chiedono un preventivo all'installatore (1 = acceso)
APP_PRELANCIO=0
# i progetti in vetrina prima che il maintainer si iscriva (vedi docs): 1 = acceso
APP_NON_RIVENDICATI=0
# i pagamenti su quei progetti finché il maintainer non li rivendica: 0 = solo richieste di preventivo. Accendilo solo dopo il
# parere dell'avvocato su dove vanno i soldi di chi non rivendica
APP_NON_RIVENDICATI_PAGAMENTI=0
# SOLO PER LE PROVE: permette i webhook in uscita verso localhost. In produzione lascialo a 0
APP_AGGANCI_LOCALI=0
# l'indirizzo su cui ascolta: 127.0.0.1 = solo da questo computer (dietro Caddy o Cloudflare Tunnel). Vuoto = da tutta la rete
#APP_HOST=127.0.0.1
# 1 = il sito arriva da Cloudflare Tunnel (il computer di casa, deploy/CASA.md): l'indirizzo di chi visita si legge da CF-Connecting-IP.
# Solo insieme a APP_HOST=127.0.0.1, altrimenti chiunque nella rete potrebbe inventarlo
APP_CLOUDFLARE=0
# il repository pubblico del codice: /versione mostra il commit che gira e porta lì (deploy/LEGGIMI.md, «Che codice gira sul sito»)
#APP_REPOSITORY=https://github.com/<organizzazione>/repobay
# (le vecchie OFFICINA_NOME, OFFICINA_URL… valgono ancora, ma le APP_* hanno la precedenza)

# ---------------------------------------------------------------- Stripe (https://dashboard.stripe.com/apikeys)
# la chiave segreta: sk_test_… per le prove, sk_live_… quando si incassa davvero (o una chiave con restrizioni rk_…)
STRIPE_CHIAVE=sk_test_…
# la chiave pubblicabile (pk_test_… / pk_live_…): la cassa /compra incorpora il pagamento nella pagina. Senza, si paga sulla
# pagina di Stripe e si torna sulla pagina d'installazione (funziona lo stesso)
STRIPE_PUBBLICA=
# i segreti di firma dei webhook (whsec_…), separati da virgola se gli endpoint sono due (account + Connect).
# Endpoint: https://<dominio>/api/stripe/webhook. Eventi: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed (SEPA), invoice.paid, charge.refunded,
# customer.subscription.deleted; sull'endpoint Connect («eventi dei conti connessi»): account.updated
STRIPE_FIRMA=whsec_…
# il paese dei conti Connect di builder e installatori
STRIPE_PAESE=IT
# «per conto»: il venditore davanti al cliente è l'installatore (on_behalf_of). 1 = acceso
STRIPE_PER_CONTO=0
# solo per le prove con un finto Stripe: in produzione non si tocca
#STRIPE_BASE=https://api.stripe.com

# ---------------------------------------------------------------- GitHub (https://github.com/settings/developers → OAuth App)
# «Authorization callback URL» dell'app: https://<dominio>/auth/github/ritorno
GITHUB_CLIENT_ID=Iv1.…
GITHUB_CLIENT_SECRET=…
# ogni quante ore si rileggono release, README, stelle e licenza dei prodotti
GITHUB_ORE=6
# solo per le prove con un finto GitHub
#GITHUB_WEB=https://github.com
#GITHUB_API=https://api.github.com

# ---------------------------------------------------------------- posta
# console (nel journal) | file | smtp | resend | postmark | brevo | sendgrid | mailgun
POSTA_DRIVER=console
# il mittente; se manca: «<APP_NOME> <noreply@<dominio di APP_URL>>»
#POSTA_DA=Repobay <noreply@tuodominio.it>
# la chiave API del servizio di posta (resend, postmark, brevo, sendgrid, mailgun)
POSTA_CHIAVE=
# il dominio di invio (Mailgun)
POSTA_DOMINIO=
# eu o us (SendGrid e Mailgun)
POSTA_REGIONE=eu
# per POSTA_DRIVER=file: dove scrivere i .eml (deve stare dentro /var/lib/repobay, l'unica cartella scrivibile)
#POSTA_CARTELLA=/var/lib/repobay/posta
# per POSTA_DRIVER=smtp
SMTP_HOST=
SMTP_PORTA=587
# 1 = TLS dall'inizio (porta 465); 0 = STARTTLS (porta 587)
SMTP_SICURO=0
SMTP_UTENTE=
SMTP_PAROLA=

# ---------------------------------------------------------------- Telegram (facoltativo)
# il gettone del bot (@BotFather) e il suo nome utente; il webhook si collega da solo se APP_URL è https
TELEGRAM_BOT=
TELEGRAM_NOME=

# ---------------------------------------------------------------- crypto (facoltativo: senza wallet sono spente)
# l'indirizzo EVM (0x…, 40 cifre esadecimali) che riceve la parte della piattaforma. Solo l'indirizzo, MAI una chiave privata
APP_WALLET=
# gli indirizzi della piattaforma sulle altre reti
WALLET_SOLANA=
WALLET_BITCOIN=
WALLET_TRON=
# le reti EVM accese, separate da virgola
APP_RETI=base,ethereum,arbitrum,polygon
# il contratto escrow, uno per rete EVM (contratti/LEGGIMI.md): con il suo indirizzo, su quella rete il pagamento resta nel
# contratto finché il cliente conferma; senza, su quella rete si paga direttamente chi riceve
#ESCROW_BASE=0x…
#ESCROW_BASE_SEPOLIA=0x…
# gli RPC sostituibili, uno per rete: RPC_<RETE>=url (es. RPC_BASE, RPC_ETHEREUM, RPC_SOLANA, RPC_BITCOIN, RPC_TRON)
#RPC_BASE=https://mainnet.base.org
# i prezzi delle monete in euro
#PREZZI_URL=https://api.coingecko.com/api/v3
# in crypto l'assistenza si paga in anticipo per questi mesi
CRYPTO_MESI=12
# per quanti minuti vale il prezzo di un ordine
CRYPTO_MINUTI=30
# la chiave di TronGrid (senza, risponde 429 dopo poche richieste)
TRONGRID_CHIAVE=

# ---------------------------------------------------------------- pagamenti diretti sul tuo conto, senza piattaforme in mezzo
# Si offrono solo quando a installare sei tu (un account fra APP_ADMIN): i soldi arrivano sul tuo conto. Valgono anche nel prelancio.
# il bonifico: il tuo IBAN e il nome del titolare come lo vede chi paga (il BIC si può lasciare vuoto)
#BONIFICO_IBAN=IT60 X054 2811 1010 0000 0123 456
#BONIFICO_INTESTATARIO=Nome Cognome
#BONIFICO_BIC=
# l'assistenza si paga in anticipo per questi mesi (da 3 a 24); per quanti giorni vale un ordine
BONIFICO_MESI=12
BONIFICO_GIORNI=10
# la carta dal POS virtuale della tua banca (Nexi XPay, il servizio e-commerce della maggior parte delle banche italiane):
# alias e chiave segreta arrivano con l'attivazione sul conto aziendale. POS_PROVA=1 usa la cassa di prova di Nexi.
# La banca manda l'esito solo a indirizzi https (APP_URL in https)
#POS_ALIAS=
#POS_CHIAVE=
#POS_PROVA=1

# ---------------------------------------------------------------- soldi (prezzi in centesimi, quote in frazioni: 0.05 = 5%)
# con carta, prima della divisione si toglie il costo vero di Stripe di quel pagamento (la fee della balance transaction, senza
# ricarichi, divisa fra le righe della fattura); 0 = il costo resta alla piattaforma, che lo paga dalla sua parte. Il sovrapprezzo
# al cliente non si fa: con le carte dei consumatori è vietato (PSD2, art. 62)
CARTA_COSTO_STRIPE=1
# la stima del costo di Stripe che le pagine mostrano prima di pagare (carte europee standard: 1,5% + 0,25 €; le carte aziendali o
# extra UE costano di più). Dopo il pagamento conta quello vero. La parte fissa in centesimi
STRIPE_STIMA_PERCENTUALE=0.015
STRIPE_STIMA_FISSO=25
# la parte della piattaforma su ogni pagamento con carta (installazioni, aggiornamenti, mance), su quello che resta dopo Stripe
QUOTA_PIATTAFORMA=0.05
# la parte della piattaforma sui pagamenti in crypto (nessun intermediario: il gas lo paga chi paga)
QUOTA_PIATTAFORMA_CRYPTO=0.01
# il prezzo dell'installazione lo decide chi vende. La sua parte, tolti Stripe e la piattaforma, quando chi sviluppa non ha scelto la
# sua percentuale (0.20 = 80% a chi sviluppa); installatore e builder possono concordarne un'altra, fra loro due e prodotto per prodotto
QUOTA_INSTALLATORE=0.20
# la percentuale più alta che chi sviluppa può scegliere su quello che resta dell'installazione (0.80 = 80%: chi vende tiene almeno il 20%)
PERCENTUALE_MASSIMA=0.80
# i livelli di chi vende, prodotto per prodotto, «vendite:fattore» sulla parte di chi sviluppa: dopo 10 vendite dello stesso prodotto
# i 13/16 (80% → 65%, a chi vende il 35%), dopo 25 i 5/8 (80% → 50%, a chi vende il 50%). Contano dal pagamento in cui si raggiunge la soglia
LIVELLI_VENDITORE=10:13/16,25:5/8
# l'assistenza: risponde per primo chi ha installato, la piattaforma (APP_ADMIN) vede ogni richiesta e interviene se lui non risponde;
# il canone mensile, tolto Stripe, va a chi ha installato (QUOTA_INSTALLATORE_ASSISTENZA) e alla piattaforma; a chi sviluppa
# QUOTA_SVILUPPATORE_ASSISTENZA (0: non può dare assistenza da un altro paese; il suo ricorrente sono gli aggiornamenti garantiti).
# 0 = il modello vecchio: il canone si divide come l'installazione e la piattaforma non vede le richieste
ASSISTENZA_PIATTAFORMA=1
# la parte di chi sviluppa sul canone dell'assistenza (0.40 = 40%, il resto alla piattaforma), divisa con i collaboratori e fissata
# alla vendita. Per un progetto a licenza d'uso interno la cui azienda non ha aderito il canone va tutto alla piattaforma
QUOTA_SVILUPPATORE_ASSISTENZA=0
# la parte di chi ha installato sul canone dell'assistenza, tolto Stripe: risponde lui per primo, la piattaforma tiene il resto
QUOTA_INSTALLATORE_ASSISTENZA=0.60
# il canone mensile dell'assistenza, in centesimi: uno solo per tutti i prodotti (3750 = 37,50 € al mese, 450 € l'anno); si cambia anche dal Pannello
ASSISTENZA_MESE=3750
# la mancia più alta che chi sviluppa può mandare a chi vende, in centesimi (solo con carta; si tolgono Stripe e la parte della piattaforma)
MANCIA_MASSIMA=50000
# la parte di chi vende sugli aggiornamenti garantiti di chi sviluppa (0 = tolti Stripe e la piattaforma, tutto a chi sviluppa)
QUOTA_INSTALLATORE_AGGIORNAMENTI=0
# il prezzo minimo, in centesimi (500 = 5 €): dell'installazione, degli aggiornamenti e delle mance
PREZZO_MINIMO=500
# perché il canone valga sempre (mai bloccare il programma): ogni quanti minuti si controlla da fuori l'indirizzo pubblico del
# programma di chi ha l'assistenza attiva (avvisi quando non risponde, rapporto del mese). Le Condizioni (art. 14) e la Garanzia
# (art. 6) scrivono 5 minuti, 90 €, 3 mesi e 30 giorni: se cambi questi valori, cambia anche quei testi
MONITOR_MINUTI=5
# la tariffa oraria degli interventi a chiamata per chi non ha l'assistenza attiva, in centesimi (preventivo pagato prima del lavoro)
TARIFFA_ORA=9000
# la riattivazione: chi chiude l'abbonamento e torna paga una volta questi mesi di canone; in crypto, se rinnova più di questi giorni
# dopo la scadenza
RIATTIVAZIONE_MESI=3
RIATTIVAZIONE_GIORNI=30
# i giorni prima di versare le quote (coprono rimborsi e contestazioni)
TRATTENUTA_GIORNI=14
# l'assistenza: giorni di grazia se un pagamento non va (poi si sospende l'assistenza, mai il programma), sconto per l'anno in anticipo,
# ore entro cui chi ha installato risponde ai clienti prima del sollecito (poi interviene la piattaforma)
GRAZIA_GIORNI=7
SCONTO_ANNO=0.10
RISPOSTA_ORE=24
# il corso per installatori (/corso): senza il test superato non si offrono programmi; i programmi impegnativi si sbloccano dopo
# CORSO_ESPERIENZA installazioni confermate dai clienti (o dal pannello). Domande per test, risposte giuste per superarlo, minuti
# prima di riprovare. CORSO_OBBLIGATORIO=0 lo spegne
CORSO_OBBLIGATORIO=1
CORSO_DOMANDE=20
CORSO_SOGLIA=16
CORSO_ATTESA_MINUTI=60
CORSO_ESPERIENZA=3
# i controlli di sicurezza sulle release: OpenSSF Scorecard sempre; antivirus e componenti se ClamAV e Trivy sono installati
# (deploy/LEGGIMI.md). Vuoti = spenti. SICUREZZA_MAX_MB: oltre questa dimensione l'archivio della release non si scarica
SICUREZZA_CLAMSCAN=
SICUREZZA_TRIVY=
SICUREZZA_MAX_MB=300
# ogni quanti minuti si versano le quote maturate
CONTROLLO_MINUTI=10
# quante copie giornaliere del database si tengono in APP_DATI/copie (0 = nessuna)
COPIE_GIORNI=14

# ---------------------------------------------------------------- Node
# la mette già il servizio; qui solo per ricordarla
NODE_ENV=production
